# ── Paraiso Booking App — Environment Variables ──────────────────────

# Cloudflare Turnstile site key (get from https://dash.cloudflare.com/turnstile)
# Use '1x00000000000000000000AA' for testing (always passes)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACxADPDrGCRJXcpM

# (Optional) Override the API base URL. In production, the frontend is
# served behind Nginx which proxies /api to the backend, so this is
# typically not needed. Set it only if the backend lives on a different origin.
# VITE_API_URL=https://api.veronicasflat.com

# CloudFront CDN URL for optimized images
# Set this to your CloudFront distribution domain (e.g. https://d123456abcdef8.cloudfront.net)
VITE_CDN_URL=https://d3lat3runlb17l.cloudfront.net
